# Where the Next.js server reaches the NestJS API (server-side fetches and the /api rewrite).
API_INTERNAL_URL=http://localhost:4000

# Cloudflare Turnstile site key (optional, public). Pair it with TURNSTILE_SECRET_KEY on the API.
# Leave empty in development: the booking form then skips the bot check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

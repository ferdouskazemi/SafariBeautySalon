NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://safari:safari@localhost:5432/safari?schema=public

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars

# Public origin of the web app (used for CORS).
WEB_ORIGIN=http://localhost:3000
# Set to true in production (HTTPS only cookies).
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (the Next.js rewrite counts as one).
TRUST_PROXY_HOPS=1

# Cloudflare Turnstile secret key (optional): when set, online bookings need a passed challenge.
# Create a free widget at dash.cloudflare.com -> Turnstile; use the matching site key in apps/web.
TURNSTILE_SECRET_KEY=

# Initial manager account created by `pnpm db:seed`.
SEED_ADMIN_PHONE=0700000000
SEED_ADMIN_PASSWORD=ChangeMe-2026

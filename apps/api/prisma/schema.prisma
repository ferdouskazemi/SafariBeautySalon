generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum ServiceCategory {
  HAIR
  BEARD
  FACE
  GROOMING
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  REVIEW_RECEIVED
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Salon team accounts. The manager is an ADMIN; barbers are STAFF and can be booked.
model User {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  title        String?
  bio          String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  /// Bumped on logout or deactivation to revoke every refresh token.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workingHours  WorkingHours[]
  appointments  Appointment[]
  notifications Notification[]

  @@map("users")
}

model WorkingHours {
  id          String @id @default(cuid())
  staffId     String
  /// JS weekday, 0 = Sunday.
  weekday     Int
  /// Salon-local minutes since midnight.
  startMinute Int
  endMinute   Int

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, weekday])
  @@map("working_hours")
}

model Service {
  id              String          @id @default(cuid())
  name            String
  description     String?
  category        ServiceCategory
  durationMinutes Int
  /// Unused: the salon no longer shows prices. Kept (default 0) so history is not lost.
  price           Int             @default(0)
  /// Index into the schedule's service colors, spread out when the service is created.
  colorIndex      Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  packageItems        PackageItem[]
  appointmentServices AppointmentService[]

  @@map("services")
}

model Package {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Unused: the salon no longer shows prices. Kept (default 0) so history is not lost.
  price       Int      @default(0)
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        PackageItem[]
  appointments Appointment[]

  @@map("packages")
}

model PackageItem {
  packageId String
  serviceId String

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
  @@map("package_items")
}

/// Guest bookings: customers identify themselves with the public `code` and their phone.
/// An appointment is for one package, or for one or more services (see AppointmentService).
model Appointment {
  id            String            @id @default(cuid())
  code          String            @unique
  customerName  String
  customerPhone String
  staffId       String
  packageId     String?
  startsAt      DateTime          @db.Timestamptz(3)
  endsAt        DateTime          @db.Timestamptz(3)
  /// Unused: prices were removed from the product. Kept (default 0) for old rows.
  price         Int               @default(0)
  status        AppointmentStatus @default(CONFIRMED)
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  staff         User                 @relation(fields: [staffId], references: [id], onDelete: Restrict)
  package       Package?             @relation(fields: [packageId], references: [id], onDelete: Restrict)
  services      AppointmentService[]
  review        Review?
  notifications Notification[]

  @@index([staffId, startsAt])
  @@index([startsAt])
  @@index([customerPhone, status])
  @@map("appointments")
}

/// The single services of a non-package appointment, in the order they are done.
model AppointmentService {
  appointmentId String
  serviceId     String
  position      Int
  /// Unused, like Appointment.price.
  price         Int    @default(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([appointmentId, serviceId])
  @@index([serviceId])
  @@map("appointment_services")
}

/// One review per completed appointment, so every rating comes from a real visit.
model Review {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  rating        Int
  comment       String?
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([isVisible, createdAt])
  @@map("reviews")
}

/// In-panel messages for the team: the booked barber and the managers hear about bookings, cancellations and reviews.
model Notification {
  id            String           @id @default(cuid())
  recipientId   String
  type          NotificationType
  appointmentId String
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  recipient   User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@map("notifications")
}
